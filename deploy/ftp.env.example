# Скопировать в deploy/ftp.env (в git не попадает) и заполнить.
# Plesk → Сайты и домены → mir-mediakit.asia → Доступ по FTP.
FTP_HOST=mir-mediakit.asia
FTP_USER=mir-mediakit
FTP_PASS=
# Корень сайта относительно домашней папки FTP-аккаунта (/mir-mediakit.asia). Пусто — скрипт найдёт сам по index.html.
FTP_REMOTE_DIR=
SITE_URL=https://mir-mediakit.asia
