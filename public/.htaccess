# Plesk (Apache): статический сайт в корне домена (httpdocs)
Options -Indexes
DirectoryIndex index.html

# Типы файлов
AddType video/mp4 .mp4
AddType image/webp .webp
AddType image/svg+xml .svg

# Редирект на HTTPS включается в Plesk: Hosting Settings → «Permanent SEO-safe 301 redirect from HTTP to HTTPS»

# Сжатие текстовых файлов
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/plain
</IfModule>

# Кэш: хэшированные ассеты — навсегда, медиа — месяц, HTML — всегда свежий
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|mp4|woff2|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
