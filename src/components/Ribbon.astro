---
// Хромированная лента: SVG-путь с металлическим градиентом, медленно «дышит» (цикл 12–13 с).
// preserveAspectRatio="none" + non-scaling-stroke: путь тянется за контейнером, толщина остаётся в пикселях.
interface Props {
  id: string;
  d: string;
  class?: string;
}
const { id, d, class: cls = '' } = Astro.props;
---

<svg class:list={['ribbon', cls]} viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${id}-g`} gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="1000" y2="420" spreadMethod="reflect">
      <stop offset="0" stop-color="#262c36"></stop>
      <stop offset=".1" stop-color="#e9edf2"></stop>
      <stop offset=".19" stop-color="#7a8391"></stop>
      <stop offset=".3" stop-color="#171b23"></stop>
      <stop offset=".42" stop-color="#f8fafc"></stop>
      <stop offset=".52" stop-color="#9aa3b2"></stop>
      <stop offset=".64" stop-color="#232933"></stop>
      <stop offset=".77" stop-color="#e3e7ed"></stop>
      <stop offset=".88" stop-color="#5b6472"></stop>
      <stop offset="1" stop-color="#f1b5c4" stop-opacity=".9"></stop>
      <animateTransform
        attributeName="gradientTransform"
        type="translate"
        values="-260 0; 260 0; -260 0"
        dur="13s"
        repeatCount="indefinite"
        calcMode="spline"
        keyTimes="0; .5; 1"
        keySplines=".45 0 .55 1; .45 0 .55 1"></animateTransform>
    </linearGradient>
    <filter id={`${id}-blur`} x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="10"></feGaussianBlur>
    </filter>
  </defs>
  <g class="ribbon__g">
    <path class="ribbon__shadow" d={d} filter={`url(#${id}-blur)`}></path>
    <path class="ribbon__rim" d={d}></path>
    <path class="ribbon__body" d={d} stroke={`url(#${id}-g)`}></path>
    <path class="ribbon__hi" d={d} transform="translate(0 -5)"></path>
  </g>
</svg>

<style>
  .ribbon {
    position: absolute;
    overflow: visible;
    pointer-events: none;
  }
  .ribbon path {
    fill: none;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .ribbon__shadow {
    stroke: rgba(0, 0, 0, 0.55);
    stroke-width: calc(var(--rw, 24px) * 1.3);
    transform: translate(0, 18px);
  }
  .ribbon__rim {
    stroke: #0b0d12;
    stroke-width: calc(var(--rw, 24px) + 3px);
  }
  .ribbon__body {
    stroke-width: var(--rw, 24px);
  }
  .ribbon__hi {
    stroke: rgba(255, 255, 255, 0.7);
    stroke-width: calc(var(--rw, 24px) * 0.12);
  }
  .ribbon__g {
    transform-box: view-box;
    transform-origin: 50% 50%;
    animation: ribbon-breathe 12s ease-in-out infinite;
  }
  @keyframes ribbon-breathe {
    0%,
    100% {
      transform: translate(0, 0) rotate(0deg) scale(1);
    }
    50% {
      transform: translate(-6px, -14px) rotate(-1.4deg) scale(1.02);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ribbon__g {
      animation: none;
    }
  }
</style>
