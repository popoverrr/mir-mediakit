---
// §5.7 — вирусные ролики (органика): лента постеров, клик → та же модалка без блока бренда.
import Icon from './Icon.astro';
import { kit, tr, channel, pickPoster, previewFor, type Locale } from '../lib/data';
import { fmtCompact, fmtInt, unitFor } from '../lib/format';
import type { Dict } from '../i18n/ru';

interface Props {
  locale: Locale;
  t: Dict;
}
const { locale: l, t } = Astro.props;
const items = kit.topContent.filter((x) => x.kind !== 'intro' && x.slug !== 'intro');
const yt = channel('youtube');
const over1m = yt?.stats.shortsOver1M;
---

{
  items.length > 0 && (
    <section class="top section" aria-labelledby="top-title">
      <div class="container">
        <div class="section-head">
          <h2 class="h2 top__title reveal" id="top-title">
            {t.top.title}
          </h2>
          {over1m != null && (
            <p class="section-head__sub reveal" style="--i:1">
              {t.top.lead(fmtInt(over1m, l))}
            </p>
          )}
        </div>

        <ul class="rail top__rail">
          {items.map((it, i) => {
            const src = it.sources[0];
            const poster = pickPoster(it.slug, it.sources);
            const preview = previewFor(it.slug);
            const views = src?.stats?.views;
            return (
              <li class="tcard reveal" style={`--i:${i % 5}`} data-case={it.slug}>
                <button type="button" class="tcard__btn" data-open-item={it.slug}>
                  <span class="sr-only">{tr(it.title, l)}:</span>
                  <span class="tcard__media">
                    {poster && (
                      <img
                        src={poster.src}
                        srcset={poster.srcset}
                        sizes={poster.srcset ? '(min-width: 1024px) 230px, 56vw' : undefined}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        width="360"
                        height="640"
                      />
                    )}
                    {preview && <video class="ccard__preview" muted loop playsinline preload="none" data-src={preview} aria-hidden="true" tabindex="-1" />}
                  </span>
                  <span class="tcard__shade" aria-hidden="true" />
                  <span class="tcard__info">
                    {views != null && (
                      <span class="tcard__v">
                        <span class="num tcard__views">{fmtCompact(views, l)}</span>
                        <span class="tcard__unit">{unitFor(views, l, t.units.views, true)}</span>
                      </span>
                    )}
                    <span class="tcard__pf">
                      {src && <Icon name={src.platform} />}
                      {src && t.platformName[src.platform as keyof typeof t.platformName]}
                    </span>
                  </span>
                </button>
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )
}

<style>
  .top {
    background: linear-gradient(180deg, var(--bg) 0%, #0b0d12 100%);
    padding-top: calc(var(--section-y) * 0.6);
  }
  .top__title {
    font-size: clamp(56px, 17vw, 180px);
  }
  .top__rail {
    grid-auto-columns: min(56vw, 230px);
    gap: 12px;
  }
  .tcard__btn {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--bg-3);
    box-shadow: 0 0 0 1px var(--line-soft);
    text-align: left;
    transition: transform 0.45s var(--ease);
  }
  .tcard__btn:hover {
    transform: translateY(-4px);
  }
  .tcard__media,
  .tcard__media img,
  .tcard__media video,
  .tcard__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tcard__media video {
    opacity: 0;
    transition: opacity 0.4s;
  }
  .tcard__media video.is-playing {
    opacity: 1;
  }
  .tcard__shade {
    background: linear-gradient(0deg, rgba(7, 8, 11, 0.92) 0%, rgba(7, 8, 11, 0.45) 30%, transparent 55%);
  }
  .tcard__info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    gap: 8px;
    padding: 14px;
  }
  .tcard__v {
    display: grid;
    gap: 2px;
  }
  .tcard__views {
    font-size: clamp(36px, 3.2vw, 46px);
    color: var(--accent);
    white-space: nowrap;
  }
  .tcard__unit {
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
  }
  .tcard__pf {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-2);
  }
  .tcard__pf :global(.ico) {
    width: 16px;
    height: 16px;
  }
  @media (min-width: 1024px) {
    .top__rail {
      grid-auto-columns: calc((100% - 4 * 14px) / 5);
      gap: 14px;
      margin-inline: 0;
      padding-inline: 0;
    }
  }
</style>
