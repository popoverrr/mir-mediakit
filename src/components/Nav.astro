---
import Icon from './Icon.astro';
import { kit, tr, withBase, type Locale } from '../lib/data';
import type { Dict } from '../i18n/ru';

interface Props {
  locale: Locale;
  t: Dict;
}
const { locale, t } = Astro.props;
const links = [
  { id: 'about', label: t.nav.about },
  { id: 'cases', label: t.nav.cases },
  { id: 'stats', label: t.nav.stats },
  { id: 'formats', label: t.nav.formats },
  { id: 'contacts', label: t.nav.contacts },
];
const cta = kit.contacts.primaryCta;
const langs = [
  { code: 'ru', href: withBase('/'), label: 'RU', name: 'Русский' },
  { code: 'en', href: withBase('/en/'), label: 'EN', name: 'English' },
];
---

<header class="nav" data-nav>
  <div class="nav__bar container">
    <a class="nav__logo" href="#top" aria-label="MIR — наверх">MIR</a>

    <nav class="nav__links" aria-label={t.nav.menu}>
      {links.map((l) => <a href={`#${l.id}`} data-spy={l.id}>{l.label}</a>)}
    </nav>

    <div class="nav__right">
      <div class="lang" role="group" aria-label={t.nav.langLabel}>
        {
          langs.map((g) => (
            <a
              class="lang__a"
              href={g.href}
              hreflang={g.code}
              lang={g.code}
              data-lang-link
              aria-current={g.code === locale ? 'true' : undefined}
              aria-label={`${g.label} — ${g.name}`}
            >
              {g.label}
            </a>
          ))
        }
      </div>
      <a class="btn nav__cta" href={cta.url} target="_blank" rel="noopener">
        <Icon name="telegram" />
        <span>{tr(cta.label, locale)}</span>
      </a>
      <button class="nav__burger" type="button" aria-expanded="false" aria-controls="nav-menu" data-burger>
        <span class="sr-only">{t.nav.menu}</span>
        <span class="nav__burger-lines" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="menu" id="nav-menu" data-menu hidden>
    <nav class="menu__links container" aria-label={t.nav.menu}>
      {
        links.map((l, i) => (
          <a href={`#${l.id}`} style={`--i:${i}`} data-menu-link>
            {l.label}
          </a>
        ))
      }
    </nav>
    <div class="menu__foot container">
      <a class="btn btn--lg" href={cta.url} target="_blank" rel="noopener">
        <Icon name="telegram" />
        {tr(cta.label, locale)}
      </a>
    </div>
  </div>
</header>

<a class="sticky-cta btn btn--lg" href={kit.contacts.telegramAds.url} target="_blank" rel="noopener" data-sticky-cta tabindex="-1" aria-hidden="true">
  <Icon name="telegram" />
  {t.nav.mobileCta}
</a>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    transition:
      background-color 0.35s,
      border-color 0.35s,
      backdrop-filter 0.35s;
    border-bottom: 1px solid transparent;
  }
  .nav.is-glass {
    background: rgba(9, 11, 15, 0.62);
    border-bottom-color: var(--line-soft);
    -webkit-backdrop-filter: blur(18px) saturate(1.3);
    backdrop-filter: blur(18px) saturate(1.3);
  }
  .nav__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 64px;
  }
  .nav__logo {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 30px;
    line-height: 1;
    letter-spacing: 0.01em;
  }
  .nav__links {
    display: none;
    gap: 4px;
  }
  .nav__links a {
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 600;
    color: var(--ink-2);
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  .nav__links a:hover,
  .nav__links a.is-active {
    color: var(--ink);
    background: rgba(255, 255, 255, 0.07);
  }
  .nav__right {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .lang {
    display: flex;
    padding: 3px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.04);
  }
  .lang__a {
    display: grid;
    place-items: center;
    min-width: 40px;
    height: 34px;
    padding: 0 8px;
    border-radius: 999px;
    font-family: var(--f-wide);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .lang__a[aria-current='true'] {
    background: var(--ink);
    color: var(--bg);
  }
  .nav__cta {
    display: none;
    min-height: 42px;
    padding: 0 18px;
    font-size: 11px;
  }
  .nav__burger {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.04);
  }
  .nav__burger-lines {
    display: grid;
    gap: 6px;
    width: 18px;
  }
  .nav__burger-lines i {
    display: block;
    height: 1.5px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.3s var(--ease);
  }
  .nav__burger[aria-expanded='true'] .nav__burger-lines i:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }
  .nav__burger[aria-expanded='true'] .nav__burger-lines i:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  .menu {
    position: fixed;
    inset: 64px 0 0;
    background: rgba(7, 8, 11, 0.96);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px 0 calc(24px + env(safe-area-inset-bottom));
    overflow-y: auto;
  }
  .menu[hidden] {
    display: none;
  }
  .menu__links {
    display: grid;
    gap: 4px;
  }
  .menu__links a {
    font-family: var(--f-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(44px, 13vw, 72px);
    line-height: 1;
    padding: 6px 0;
    border-bottom: 1px solid var(--line-soft);
    animation: menu-in 0.5s var(--ease) both;
    animation-delay: calc(var(--i) * 50ms);
  }
  .menu__foot .btn {
    width: 100%;
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  .sticky-cta {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: calc(12px + env(safe-area-inset-bottom));
    z-index: 40;
    transform: translateY(140%);
    opacity: 0;
    transition:
      transform 0.45s var(--ease),
      opacity 0.3s;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.6),
      0 18px 40px -10px rgba(0, 0, 0, 0.8);
  }
  .sticky-cta.is-on {
    transform: none;
    opacity: 1;
  }

  @media (min-width: 1024px) {
    .nav__bar {
      height: 72px;
    }
    .nav__links {
      display: flex;
    }
    .nav__cta {
      display: inline-flex;
    }
    .nav__burger,
    .menu,
    .sticky-cta {
      display: none !important;
    }
  }
  @media (min-width: 1024px) and (max-width: 1180px) {
    .nav__links a {
      padding: 8px 10px;
      font-size: 14px;
    }
    .nav__cta span {
      display: none;
    }
    .nav__cta {
      padding: 0 12px;
    }
  }
</style>
