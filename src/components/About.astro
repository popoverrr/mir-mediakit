---
// §5.3 — «Обо мне» по мотивам ref-02: портрет со свечением в центре, направления слева, факты справа.
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { kit, tr, trList, type Locale } from '../lib/data';
import { photo, art } from '../lib/photos';
import type { Dict } from '../i18n/ru';

interface Props {
  locale: Locale;
  t: Dict;
}
const { locale: l, t } = Astro.props;
const p = kit.profile;
const cutout = photo('about-cutout');
const portrait = cutout ?? photo('about');
const artLayer = art('art-');
const intro = kit.topContent.find((x) => x.kind === 'intro' || x.slug === 'intro');
const roles = trList(p.roles, l);

const facts = [
  p.age ? `${t.about.age(p.age)} · ${tr(p.origin, l)}` : tr(p.origin, l),
  t.about.rinkiwi,
  roles[2] ? roles[2].charAt(0).toUpperCase() + roles[2].slice(1) : null,
].filter(Boolean) as string[];

const restrictions = kit.restrictions?.status !== 'missing' && kit.restrictions?.items?.length ? kit.restrictions.items : null;
---

<section class="about section section--steel" id="about" aria-labelledby="about-title">
  {
    artLayer.length > 0 && (
      <div class="about__art" aria-hidden="true">
        {artLayer.slice(0, 2).map((a, i) => (
          <Picture src={a} alt="" formats={['avif', 'webp']} widths={[360, 540]} sizes="(min-width: 1024px) 34vw, 60vw" class={`about__art-img about__art-img--${i}`} loading="lazy" />
        ))}
      </div>
    )
  }

  <div class="container about__grid">
    <h2 class="h2 about__title reveal" id="about-title">{t.about.title}</h2>

    <figure class:list={['about__portrait', cutout ? 'is-cutout' : 'is-framed']}>
      <span class="about__glow" aria-hidden="true"></span>
      {
        portrait && (
          <Picture
            src={portrait}
            alt={t.about.portraitAlt}
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            widths={[360, 540, 720]}
            sizes="(min-width: 1024px) 420px, 78vw"
            class="about__img"
            loading="lazy"
          />
        )
      }
    </figure>

    <div class="about__pillars">
      <p class="label about__cap">{t.about.pillars}</p>
      <ul>
        {
          kit.contentPillars.map((pl, i) => (
            <li class="reveal" style={`--i:${i}`}>
              <h3 class="about__pillar-title">{tr(pl.title, l)}</h3>
              <p class="about__pillar-text">{tr(pl.text, l)}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="about__facts">
      <p class="label about__cap">{t.about.facts}</p>
      <ul class="about__big">
        {
          facts.map((f, i) => (
            <li class="reveal" style={`--i:${i}`}>
              <Icon name="star" class="star" />
              <span>{f}</span>
            </li>
          ))
        }
      </ul>
      <p class="label about__cap about__cap--why">{t.about.why}</p>
      <ul class="about__why">
        {
          kit.whyMe.map((w, i) => (
            <li class="reveal" style={`--i:${i + 3}`}>
              <Icon name="star" class="star" />
              <span>{tr(w, l)}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="about__bio glass reveal">
      <div class="glass__inner about__bio-inner">
        <p>{tr(p.bioLong, l)}</p>
        {
          intro && (
            <button class="btn about__intro" type="button" data-open-item={intro.slug}>
              <Icon name="play" />
              {t.about.watchIntro}
            </button>
          )
        }
      </div>
    </div>

    {
      restrictions && (
        <div class="about__restr card-plain">
          <p class="label">{t.about.restrictions}</p>
          <ul>
            {restrictions.map((r) => (
              <li>{typeof r === 'string' ? r : tr(r, l)}</li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>

<style>
  .about {
    overflow: clip;
  }
  .about__art {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  .about__art :global(.about__art-img) {
    position: absolute;
    width: min(60vw, 520px);
    height: auto;
    /* карандашный лист проступает сквозь сталь, края растворяются */
    filter: grayscale(1) contrast(1.1);
    mix-blend-mode: soft-light;
    opacity: 0.4;
    -webkit-mask-image: radial-gradient(closest-side, #000 45%, transparent 100%);
    mask-image: radial-gradient(closest-side, #000 45%, transparent 100%);
  }
  .about__art :global(.about__art-img--0) {
    left: -10%;
    bottom: -8%;
    transform: rotate(-6deg);
  }
  .about__art :global(.about__art-img--1) {
    right: -12%;
    bottom: -14%;
    transform: rotate(5deg);
  }

  .about__grid {
    display: grid;
    gap: 36px;
  }
  .about__title {
    font-size: clamp(64px, 20vw, 190px);
  }
  .about__cap {
    color: var(--muted);
    margin-bottom: 18px;
  }

  /* портрет */
  .about__portrait {
    position: relative;
    margin: 0 auto;
    width: min(78vw, 420px);
    isolation: isolate;
  }
  .about__glow {
    position: absolute;
    inset: -12% -18% 10%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(241, 181, 196, 0.35), rgba(223, 227, 234, 0.22) 45%, transparent 75%);
    filter: blur(20px);
  }
  .about__portrait :global(.about__img) {
    width: 100%;
    height: auto;
  }
  .is-framed :global(.about__img) {
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.16),
      0 40px 80px -30px rgba(0, 0, 0, 0.9);
    -webkit-mask-image: linear-gradient(180deg, #000 70%, transparent 100%);
    mask-image: linear-gradient(180deg, #000 70%, transparent 100%);
  }
  .is-cutout :global(.about__img) {
    filter: drop-shadow(0 0 28px rgba(223, 227, 234, 0.35));
    /* края кадра растворяются: плечо и низ не обрываются по границе фото */
    -webkit-mask-image: radial-gradient(ellipse 62% 70% at 50% 42%, #000 58%, transparent 100%);
    mask-image: radial-gradient(ellipse 62% 70% at 50% 42%, #000 58%, transparent 100%);
  }

  /* направления */
  .about__pillars ul {
    display: grid;
    gap: 22px;
  }
  .about__pillar-title {
    font-family: var(--f-wide);
    font-weight: 700;
    font-size: 17px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin-bottom: 6px;
  }
  .about__pillar-text {
    color: var(--ink-2);
    font-size: 16px;
    max-width: 36ch;
  }

  /* факты */
  .about__big,
  .about__why {
    display: grid;
    gap: 16px;
  }
  .about__big li,
  .about__why li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }
  .about__big li {
    font-family: var(--f-wide);
    font-weight: 700;
    font-size: clamp(17px, 1.6vw, 22px);
    line-height: 1.2;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
  .about__big :global(.star) {
    margin-top: 2px;
  }
  .about__why li {
    color: var(--ink-2);
    font-size: 16px;
  }
  .about__why :global(.star) {
    width: 14px;
    height: 14px;
    margin-top: 4px;
    color: var(--accent);
  }
  .about__cap--why {
    margin-top: 32px;
  }

  /* био */
  .about__bio {
    max-width: 760px;
    margin-inline: auto;
    width: 100%;
  }
  .about__bio-inner {
    display: grid;
    gap: 22px;
    justify-items: center;
    text-align: center;
    padding: 28px 22px;
    font-size: 17px;
    line-height: 1.6;
  }
  .about__restr {
    padding: 22px;
  }

  @media (min-width: 1024px) {
    .about__grid {
      grid-template-columns: 1fr minmax(420px, 500px) 1fr;
      grid-template-areas:
        'title title facts'
        'pillars portrait facts'
        'pillars bio facts'
        'restr restr restr';
      column-gap: 40px;
      row-gap: 0;
      align-items: start;
    }
    .about__title {
      grid-area: title;
      position: relative;
      z-index: 2;
      margin-bottom: -0.3em;
    }
    .about__portrait {
      grid-area: portrait;
      width: 100%;
      margin-top: -40px;
    }
    .about__pillars {
      grid-area: pillars;
      padding-top: 80px;
    }
    .about__facts {
      grid-area: facts;
      padding-top: 24px;
    }
    .about__bio {
      grid-area: bio;
      margin-top: -120px;
      position: relative;
      z-index: 3;
    }
    .about__restr {
      grid-area: restr;
      margin-top: 32px;
    }
    .about__bio-inner {
      padding: 28px 32px;
      font-size: 16px;
    }
  }
</style>
