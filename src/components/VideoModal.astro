---
// Модалка просмотра: плеер (локальный mp4 или embed — только по клику) + карточка кейса.
// Данные — JSON на странице, разметку заполняет src/scripts/modal.ts.
import Icon from './Icon.astro';
import { kit, visibleCases, clientCase, clientTop, type Locale } from '../lib/data';
import type { Dict } from '../i18n/ru';

interface Props {
  locale: Locale;
  t: Dict;
}
const { locale: l, t } = Astro.props;
const cases = visibleCases();
const items = [...cases.map((c) => clientCase(c, l, t)), ...kit.topContent.map((x) => clientTop(x, l))];
const payload = {
  locale: l,
  items,
  t: {
    ...t.modal,
    units: t.units,
    platformName: t.platformName,
  },
};
---

<dialog class="vm" data-modal aria-labelledby="vm-title" aria-label={t.modal.dialog}>
  <div class="vm__wrap" data-swipe>
    <div class="vm__player" data-player></div>

    <div class="vm__side">
      <div class="vm__head">
        <p class="label vm__cat" data-cat></p>
        <h2 class="vm__title" id="vm-title" data-title></h2>
        <p class="vm__handle-wrap" data-handle></p>
      </div>
      <p class="vm__summary" data-summary></p>
      <p class="vm__totals" data-totals></p>

      <div class="vm__block">
        <p class="label vm__cap">
          {t.modal.metrics}
          <span class="vm__date" data-date></span>
        </p>
        <dl class="vm__metrics" data-metrics></dl>
      </div>

      <div class="vm__block" data-list-wrap>
        <p class="label vm__cap">{t.modal.campaign}</p>
        <ol class="vm__list" data-list></ol>
      </div>
    </div>

    <div class="vm__bar">
      <button type="button" class="vm__btn" data-prev aria-label={t.modal.prev}><Icon name="arrow-left" /></button>
      <button type="button" class="vm__btn" data-next aria-label={t.modal.next}><Icon name="arrow-right" /></button>
      <button type="button" class="vm__btn vm__btn--close" data-close aria-label={t.modal.close} autofocus><Icon name="close" /></button>
    </div>
  </div>
</dialog>

<script is:inline type="application/json" id="mk-data" set:html={JSON.stringify(payload).replace(/</g, '\\u003c')} />

<style is:global>
  .vm {
    padding: 0;
    border: 0;
    margin: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    background: transparent;
    color: var(--ink);
    overflow: hidden;
  }
  .vm::backdrop {
    background: rgba(4, 5, 7, 0.86);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
  }
  .vm[open] {
    animation: vm-in 0.35s var(--ease);
  }
  @keyframes vm-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
  }
  .vm__wrap {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    overflow-y: auto;
    overscroll-behavior: contain;
    transition: transform 0.25s var(--ease);
  }
  .vm__player {
    position: relative;
    flex: none;
    height: min(64svh, 177.7vw);
    background: #000;
    overflow: hidden;
  }
  .vm__player video,
  .vm__player iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    background: #000;
  }
  .vm__player video {
    object-fit: contain;
  }
  .vm__facade {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 14px;
    text-align: center;
    padding: 24px;
    color: var(--ink);
  }
  .vm__facade img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.45;
    filter: blur(2px);
  }
  .vm__facade > * {
    position: relative;
  }
  .vm__loading {
    position: absolute;
    inset: auto 0 16px;
    text-align: center;
    color: var(--muted);
    font-size: 13px;
    pointer-events: none;
  }

  .vm__side {
    display: grid;
    align-content: start;
    gap: 16px;
    padding: 22px 18px 40px;
  }
  .vm__cat {
    color: var(--muted);
  }
  .vm__title {
    font-family: var(--f-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(40px, 9vw, 64px);
    line-height: 0.9;
    margin-top: 6px;
    padding-right: 4px;
  }
  .vm__handle-wrap {
    margin-top: 8px;
  }
  .vm__handle-wrap:empty {
    display: none;
  }
  .vm__handle-wrap a {
    color: var(--accent);
    font-weight: 600;
  }
  .vm__summary {
    color: var(--ink-2);
    font-size: 16px;
  }
  .vm__totals {
    font-weight: 600;
  }
  .vm__summary:empty,
  .vm__totals:empty {
    display: none;
  }
  .vm__cap {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .vm__date {
    text-transform: none;
    font-family: var(--f-text);
    font-size: 13px;
    letter-spacing: 0;
  }
  .vm__metrics {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    gap: 1px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
  }
  .vm__metrics div {
    display: flex;
    flex-direction: column-reverse;
    padding: 12px;
    background: var(--bg-2);
  }
  .vm__metrics dd {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 28px;
    line-height: 1;
    color: var(--accent);
  }
  .vm__metrics dt {
    color: var(--muted);
    font-size: 12px;
    margin-top: 6px;
  }
  .vm__metrics-empty {
    grid-column: 1 / -1;
    padding: 12px;
    background: var(--bg-2);
    color: var(--muted);
    font-size: 14px;
  }
  .vm__list {
    display: grid;
    gap: 6px;
    padding: 0;
    list-style: none;
  }
  .vm__item {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 10px;
    padding: 8px 8px 8px 12px;
    border-radius: 14px;
    background: var(--bg-2);
    border: 1px solid var(--line-soft);
  }
  .vm__item.is-current {
    border-color: rgba(241, 181, 196, 0.55);
  }
  .vm__item-pf {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.07);
  }
  .vm__item-pf .ico,
  .vm__item-pf svg {
    width: 16px;
    height: 16px;
  }
  .vm__item-main {
    display: grid;
    min-width: 0;
    font-size: 14px;
    line-height: 1.3;
  }
  .vm__item-main b {
    font-weight: 600;
  }
  .vm__item-main span {
    color: var(--muted);
    font-size: 12.5px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .vm__ibtn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.04);
    color: var(--ink);
  }
  .vm__ibtn:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  .vm__ibtn[aria-pressed='true'] {
    background: var(--accent);
    color: var(--accent-ink);
    border-color: var(--accent);
  }
  .vm__ibtn svg {
    width: 16px;
    height: 16px;
  }

  .vm__bar {
    position: absolute;
    top: 10px;
    right: 10px;
    display: flex;
    gap: 8px;
    z-index: 3;
  }
  .vm__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(12, 14, 19, 0.7);
    border: 1px solid var(--line);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: var(--ink);
  }
  .vm__btn:hover {
    background: rgba(40, 44, 54, 0.9);
  }
  .vm__btn[hidden] {
    display: none;
  }
  .vm.is-top [data-list-wrap] {
    display: none;
  }

  @media (min-width: 900px) {
    .vm {
      padding: 3vh 3vw;
    }
    .vm__wrap {
      max-width: 1180px;
      height: 94vh;
      margin: 0 auto;
      display: grid;
      grid-template-columns: auto minmax(340px, 1fr);
      border-radius: 28px;
      border: 1px solid var(--line);
      overflow: hidden;
      box-shadow: 0 60px 120px -30px rgba(0, 0, 0, 0.9);
    }
    .vm__player {
      height: 94vh;
      aspect-ratio: 9 / 16;
      max-width: 56vw;
    }
    .vm__side {
      overflow-y: auto;
      padding: 72px 36px 36px;
    }
    .vm__bar {
      top: 16px;
      right: 16px;
    }
  }

  html.vm-lock {
    overflow: hidden;
  }
</style>
